version: '3.8'
 
services:
  classpulse-frontend:
    container_name: classpulse-frontend
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "3000:3000"
    env_file:
      - .env.local
    environment:
      - NODE_ENV=development
      - WATCHPACK_POLLING=true
      - CHOKIDAR_USEPOLLING=true
      - CHOKIDAR_INTERVAL=500
    volumes:
      - .:/app
      - /app/node_modules
      - /app/.next
    command: npm run dev
    restart: unless-stopped
    networks:
      - classpulse-network
    depends_on:
      - n8n
 
  n8n:
    container_name: classpulse-n8n
    build:
      context: .
      dockerfile: Dockerfile.n8n
    ports:
      - "5678:5678"
    env_file:
      - .env.local
    environment:
      - N8N_HOST=n8n.task-master.click
      - N8N_PORT=5678
      - N8N_PROTOCOL=http
      - N8N_LISTEN_ADDRESS=0.0.0.0
      - WEBHOOK_URL=https://n8n.task-master.click/
      - N8N_USER_FOLDER=/data
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_DATABASE=n8n
      - DB_POSTGRESDB_USER=n8n
      - DB_POSTGRESDB_PASSWORD=${N8N_POSTGRES_PASSWORD:-change-me}
      # Optional: basic auth to protect the n8n UI
      # - N8N_BASIC_AUTH_ACTIVE=true
      # - N8N_BASIC_AUTH_USER=admin
      # - N8N_BASIC_AUTH_PASSWORD=changeme
    volumes:
      - n8n_data:/data
    restart: unless-stopped
    networks:
      - classpulse-network
    depends_on:
      postgres:
        condition: service_healthy
 
  postgres:
    container_name: classpulse-postgres
    image: postgres:16-alpine
    environment:
      - POSTGRES_DB=n8n
      - POSTGRES_USER=n8n
      - POSTGRES_PASSWORD=${N8N_POSTGRES_PASSWORD:-change-me}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    restart: unless-stopped
    networks:
      - classpulse-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U n8n -d n8n"]
      interval: 10s
      timeout: 5s
      retries: 5
 
networks:
  classpulse-network:
    driver: bridge
 
volumes:
  n8n_data:
    driver: local
  postgres_data:
    driver: local
 
 
